# Run python3 scripts/setup.py to generate unique local secrets.
POSTGRES_PASSWORD=GENERATE
N8N_ENCRYPTION_KEY=GENERATE
ANALYZER_TOKEN=GENERATE
WEBHOOK_PATH=GENERATE
N8N_PORT=5680
ANALYZER_PORT=8010
GATEWAY_PORT=8787
PUBLIC_WEBHOOK_URL=http://localhost:8787/
# OLLAMA_RUNTIME: native = project-local macOS Ollama (setup.py picks this on macOS); docker = the ollama container
# (CPU only, unless COMPOSE_FILE=compose.yaml:compose.gpu.yaml adds an NVIDIA GPU); external = an Ollama you run
# yourself, e.g. the Ollama for Windows app: then use an empty COMPOSE_PROFILES and point OLLAMA_BASE_URL at
# host.docker.internal port 11434.
OLLAMA_RUNTIME=docker
COMPOSE_PROFILES=docker-ai
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
AI_TIMEOUT_SECONDS=120
MIN_CONFIDENCE=75
MIN_ADX=20
MIN_ATR_PERCENT=0.02
MAX_ATR_PERCENT=0.5
MAX_SIGNAL_AGE_SECONDS=300
FILTER_SESSIONS=true
# Tickers the analyzer accepts; tickers in SESSION_EXEMPT_SYMBOLS trade around the clock and skip the session filter.
SYMBOLS=XAUUSD
SESSION_EXEMPT_SYMBOLS=BTCUSD,BTCUSDT
# Reference levels in messages: stop beyond prior swing (bounded 1-3 ATR) else STOP_ATR_MULTIPLE x ATR; TPs at R multiples.
STOP_ATR_MULTIPLE=1.5
TP_R_MULTIPLES=1,2,3,4
# SMC/ICT model: killzones in New York time (London, NY AM, NY PM), HTF bias and discount/premium requirements, minimum reward:risk to TP1.
KILLZONES=London,NY AM
REQUIRE_HTF_BIAS=true
REQUIRE_DISCOUNT=true
MIN_RR=1.0
# News filter (ForexFactory weekly calendar): block setups near high-impact events for these currencies.
NEWS_FILTER=true
NEWS_WINDOW_BEFORE_MIN=30
NEWS_WINDOW_AFTER_MIN=15
NEWS_CURRENCIES=USD
# Position sizing in messages: ACCOUNT_SIZE 0 hides it. CONTRACT_SIZES = units per lot per symbol.
ACCOUNT_SIZE=0
RISK_PERCENT=0.5
CONTRACT_SIZES=XAUUSD=100
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
