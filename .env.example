# Run python3 scripts/setup.py to generate unique local secrets.
POSTGRES_PASSWORD=GENERATE
N8N_ENCRYPTION_KEY=GENERATE
ANALYZER_TOKEN=GENERATE
WEBHOOK_PATH=GENERATE
N8N_PORT=5680
ANALYZER_PORT=8010
GATEWAY_PORT=8787
# Public website (Next.js) on loopback; publish it through a tunnel, never the analyzer or n8n.
WEB_PORT=3000
# Read-only record api on loopback, used by `npm run dev` in frontend/ (API_URL defaults to this port).
API_PORT=8091
WEB_CACHE_SECONDS=60
# Telegram channel/group invite link for the site's Telegram buttons (baked in at frontend build; rebuild after changing).
NEXT_PUBLIC_TELEGRAM_URL=
PUBLIC_WEBHOOK_URL=http://localhost:8787/
# OLLAMA_RUNTIME: native = project-local macOS Ollama (setup.py picks this on macOS); docker = the ollama container
# (CPU only, unless COMPOSE_FILE=compose.yaml:compose.gpu.yaml adds an NVIDIA GPU); external = an Ollama you run
# yourself, e.g. the Ollama for Windows app: then use an empty COMPOSE_PROFILES and point OLLAMA_BASE_URL at
# host.docker.internal port 11434.
OLLAMA_RUNTIME=docker
COMPOSE_PROFILES=docker-ai
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TIMEOUT_SECONDS=120
# GATE_MODE: rules = the technical rules decide and the model only writes commentary; ai = the model must also approve.
GATE_MODE=rules
# Rules mode: the local model's review of each approved signal is sent as a separate message right after the alert
# (it never delays, decides or expires a signal). TRADE_NOTES adds a 1-2 line local review after each closed trade.
AI_COMMENTARY=true
TRADE_NOTES=true
MIN_CONFIDENCE=75
MIN_ADX=20
MIN_ATR_PERCENT=0.02
MAX_ATR_PERCENT=0.5
MAX_SIGNAL_AGE_SECONDS=300
FILTER_SESSIONS=true
# Tickers the analyzer accepts; tickers in SESSION_EXEMPT_SYMBOLS trade around the clock and skip the session filter.
SYMBOLS=XAUUSD
SESSION_EXEMPT_SYMBOLS=BTCUSD,BTCUSDT
# Reference levels in messages: stop beyond prior swing (bounded 1-3 ATR) else STOP_ATR_MULTIPLE x ATR; TPs at R multiples.
STOP_ATR_MULTIPLE=1.5
TP_R_MULTIPLES=1,2,3,4
# CRT (Candle Range Theory): the previous HTF candle's range swept on one side by the next candle, which closes back
# inside; market entry at that close, stop beyond its wick + CRT_STOP_BUFFER_ATR x 15m ATR, target the opposite extreme.
# HTF candles are rebuilt from M15 in New York time (17:00 roll): CRT_HTF_HOURS 4 = H4 (1 = H1, 24 = D1).
# CRT_KEY_TIMES = New York open hours of the sweep candle that may signal (e.g. 1,5,9); empty = every candle.
# CRT_MAX_HOLD_CANDLES = HTF candles after the signal before a timed exit. Backtest evidence: README "CRT model".
CRT_HTF_HOURS=4
CRT_KEY_TIMES=
CRT_MIN_RR=2.0
CRT_STOP_BUFFER_ATR=0.1
CRT_MAX_HOLD_CANDLES=3
# TP2+ for CRT, in R beyond TP1 (the range extreme); after TP1 the stop moves to entry. Empty = TP1 only.
CRT_EXTRA_TARGETS_R=0.5,1,1.5
# ICT 2022 model on M5 (scripts/ict_engine.py), run next to CRT by a second feeder: a killzone sweep of the previous
# day / Asia / London high or low, a close through the last swing, then a LIMIT at the fair value gap's near edge;
# stop beyond the sweep, one target at ICT_MIN_RR. Accepted only for ICT_SYMBOLS: it held up on EURUSD over three
# years and lost on gold (README "ICT model"). Unfilled limits cancel after ICT_ENTRY_EXPIRY_MINUTES.
ICT_SYMBOLS=EURUSD
ICT_MIN_RR=2.0
ICT_ENTRY_EXPIRY_MINUTES=120
ICT_MAX_HOLD_MINUTES=360
# EMA pullback scalp on M1 (scripts/ema_engine.py), added to a feeder with --models crt,ema: the EMA20/50/200 stack
# gives the trend, a dip into EMA20 that holds above EMA200 and the first candle resuming through the previous
# candle's high/low gives the market entry; stop beyond the pullback extreme, one target at EMA_MIN_RR, closed at
# market after EMA_MAX_HOLD_MINUTES. Forward test: accepted only for EMA_SYMBOLS. One open plan per model and side.
EMA_SYMBOLS=XAUUSD
EMA_MIN_RR=1.5
EMA_MAX_HOLD_MINUTES=45
# Sweep + market structure shift on H1 (scripts/mss_engine.py), added to a feeder with --models crt,mss: an H1 wick
# through the last 2/2 swing that closes back, then a displacement candle (body >= MSS_BODY_ATR x H1 ATR) closing
# through the opposing swing. Market entry at that close, stop beyond the sweep wick + MSS_STOP_BUFFER_ATR x ATR, one
# target at the next swing or MSS_MIN_RR, closed at market after MSS_MAX_HOLD_HOURS. Forward test only: accepted for
# MSS_SYMBOLS. Backtest evidence: README "MSS model".
MSS_SYMBOLS=XAUUSD
MSS_MIN_RR=2.0
MSS_STOP_BUFFER_ATR=0.5
MSS_BODY_ATR=1.5
MSS_MAX_HOLD_HOURS=120
# News filter (ForexFactory weekly calendar): block setups near high-impact events for these currencies.
NEWS_FILTER=true
NEWS_WINDOW_BEFORE_MIN=30
NEWS_WINDOW_AFTER_MIN=15
NEWS_CURRENCIES=USD
# After this age a failed calendar refresh is UNKNOWN, never incorrectly reported as clear.
NEWS_MAX_STALE_SECONDS=7200
# Position sizing in messages: ACCOUNT_SIZE 0 hides it. CONTRACT_SIZES = units per lot per symbol.
ACCOUNT_SIZE=0
RISK_PERCENT=0.5
CONTRACT_SIZES=XAUUSD=100
# One open plan per symbol and side (0 = no limit); soft cautions for news within NEWS_CAUTION_MIN minutes;
# a history warning once the record holds HISTORY_MIN_SAMPLES closed trades for the same symbol, side, model and session.
MAX_OPEN_SAME_DIRECTION=1
NEWS_CAUTION_MIN=120
HISTORY_MIN_SAMPLES=30
HISTORY_DAYS=60
# Outcome grading on broker M1 candles (sent by scripts/mt5_feeder.py): limit entries expire, open trades time out.
# MAX_HOLD_MINUTES applies to classic; CRT trades time out after CRT_MAX_HOLD_CANDLES range candles.
ENTRY_EXPIRY_MINUTES=120
MAX_HOLD_MINUTES=1440
# Forward-test verdict: at least GO_MIN_TRADES closed trades, positive expectancy, drawdown within GO_MAX_DRAWDOWN_R.
GO_MIN_TRADES=150
GO_MAX_DRAWDOWN_R=10
# Daily record with the ledger chain hash, sent at DIGEST_HOUR local time to TELEGRAM_DIGEST_CHAT_ID (default: TELEGRAM_CHAT_ID).
DIGEST_HOUR=7
DIGEST_TIMEZONE=Asia/Phnom_Penh
# Telegram alert layout: compact (short, phone-readable; default) or detailed (every rule reading plus the AI note).
MESSAGE_STYLE=compact
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_CHAT_ID=

# --- AI agent (README "AI agent"). Read-only: it never places, edits or closes trades. ---
# Telegram assistant: answers only TELEGRAM_CHAT_ID as a private chat, from TELEGRAM_ALLOWED_USER_ID (default: same id).
AGENT_ENABLED=false
TELEGRAM_ALLOWED_USER_ID=
AGENT_MEMORY_TURNS=10
AGENT_MEMORY_RETENTION_DAYS=30
AGENT_RATE_LIMIT_PER_HOUR=60
# A free-text question goes to OpenAI only when the local router is at least this sure it needs deep analysis.
AGENT_DEEP_MIN_CONFIDENCE=70
AGENT_MAX_TOOL_CALLS=5
AGENT_TOOL_OUTPUT_CHARS=8000
AGENT_DEEP_TIMEOUT_SECONDS=180
# OpenAI (deep questions and the weekly report only). Keep the key on the server; never commit it. Verify the model id
# your account can use with the Responses API before setting OPENAI_MODEL (e.g. gpt-6-astra).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_TIMEOUT_SECONDS=90
# Hard limits, enforced before every request: deep jobs per local day, and USD per local month minus the reserve.
OPENAI_DAILY_LIMIT=20
OPENAI_MONTHLY_BUDGET_USD=10
OPENAI_SAFETY_RESERVE_USD=1
# USD per 1M tokens, used for the estimates in /cost and the budget. Update them when OpenAI's price list changes.
OPENAI_PRICE_INPUT=10
OPENAI_PRICE_CACHED_INPUT=1
OPENAI_PRICE_OUTPUT=50
# Weekly report (statistics by code, interpretation by OpenAI) to the digest chat.
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_DAY=sun
WEEKLY_REPORT_HOUR=9
WEEKLY_REPORT_TIMEZONE=Asia/Phnom_Penh

# Community group or channel: real approved signals (without your lot size) and their results.
# Tests and rejected setups stay in TELEGRAM_CHAT_ID. Add the bot to the group first; empty = off.
TELEGRAM_COMMUNITY_CHAT_ID=
