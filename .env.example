# Run python3 scripts/setup.py to generate unique local secrets.
POSTGRES_PASSWORD=GENERATE
N8N_ENCRYPTION_KEY=GENERATE
ANALYZER_TOKEN=GENERATE
WEBHOOK_PATH=GENERATE
N8N_PORT=5680
ANALYZER_PORT=8010
GATEWAY_PORT=8787
PUBLIC_WEBHOOK_URL=http://localhost:8787/
# OLLAMA_RUNTIME: native = project-local macOS Ollama (setup.py picks this on macOS); docker = the ollama container
# (CPU only, unless COMPOSE_FILE=compose.yaml:compose.gpu.yaml adds an NVIDIA GPU); external = an Ollama you run
# yourself, e.g. the Ollama for Windows app: then use an empty COMPOSE_PROFILES and point OLLAMA_BASE_URL at
# host.docker.internal port 11434.
OLLAMA_RUNTIME=docker
COMPOSE_PROFILES=docker-ai
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
AI_TIMEOUT_SECONDS=120
# GATE_MODE: rules = the technical rules decide and the model only writes commentary; ai = the model must also approve.
GATE_MODE=rules
# In rules mode this can be disabled for the fastest deterministic approval. Commentary never decides or expires a signal.
AI_COMMENTARY=true
MIN_CONFIDENCE=75
MIN_ADX=20
MIN_ATR_PERCENT=0.02
MAX_ATR_PERCENT=0.5
MAX_SIGNAL_AGE_SECONDS=300
FILTER_SESSIONS=true
# Tickers the analyzer accepts; tickers in SESSION_EXEMPT_SYMBOLS trade around the clock and skip the session filter.
SYMBOLS=XAUUSD
SESSION_EXEMPT_SYMBOLS=BTCUSD,BTCUSDT
# Reference levels in messages: stop beyond prior swing (bounded 1-3 ATR) else STOP_ATR_MULTIPLE x ATR; TPs at R multiples.
STOP_ATR_MULTIPLE=1.5
TP_R_MULTIPLES=1,2,3,4
# SMC/ICT model: killzones in New York time (London, NY AM, NY PM), HTF bias and discount/premium requirements, minimum reward:risk to TP1.
KILLZONES=London,NY AM
REQUIRE_HTF_BIAS=true
REQUIRE_DISCOUNT=true
MIN_RR=1.5
MIN_SMC_SCORE=70
# News filter (ForexFactory weekly calendar): block setups near high-impact events for these currencies.
NEWS_FILTER=true
NEWS_WINDOW_BEFORE_MIN=30
NEWS_WINDOW_AFTER_MIN=15
NEWS_CURRENCIES=USD
# After this age a failed calendar refresh is UNKNOWN, never incorrectly reported as clear.
NEWS_MAX_STALE_SECONDS=7200
# Position sizing in messages: ACCOUNT_SIZE 0 hides it. CONTRACT_SIZES = units per lot per symbol.
ACCOUNT_SIZE=0
RISK_PERCENT=0.5
CONTRACT_SIZES=XAUUSD=100
# One open plan per symbol and side (0 = no limit); soft cautions for news within NEWS_CAUTION_MIN minutes;
# a history warning once the record holds HISTORY_MIN_SAMPLES closed trades for the same symbol, side, model and session.
MAX_OPEN_SAME_DIRECTION=1
NEWS_CAUTION_MIN=120
HISTORY_MIN_SAMPLES=30
HISTORY_DAYS=60
# Outcome grading on broker M1 candles (sent by scripts/mt5_feeder.py): limit entries expire, open trades time out.
ENTRY_EXPIRY_MINUTES=120
MAX_HOLD_MINUTES=1440
# Forward-test verdict: at least GO_MIN_TRADES closed trades, positive expectancy, drawdown within GO_MAX_DRAWDOWN_R.
GO_MIN_TRADES=150
GO_MAX_DRAWDOWN_R=10
# Daily record with the ledger chain hash, sent at DIGEST_HOUR local time to TELEGRAM_DIGEST_CHAT_ID (default: TELEGRAM_CHAT_ID).
DIGEST_HOUR=7
DIGEST_TIMEZONE=Asia/Phnom_Penh
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_CHAT_ID=
