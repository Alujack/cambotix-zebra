# Run python3 scripts/setup.py to generate unique local secrets.
POSTGRES_PASSWORD=GENERATE
N8N_ENCRYPTION_KEY=GENERATE
ANALYZER_TOKEN=GENERATE
WEBHOOK_PATH=GENERATE
N8N_PORT=5680
ANALYZER_PORT=8010
GATEWAY_PORT=8787
PUBLIC_WEBHOOK_URL=http://localhost:8787/
# setup.py selects native Ollama on macOS and Docker elsewhere.
OLLAMA_RUNTIME=docker
COMPOSE_PROFILES=docker-ai
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
AI_TIMEOUT_SECONDS=120
MIN_CONFIDENCE=75
MIN_ADX=20
MIN_ATR_PERCENT=0.02
MAX_ATR_PERCENT=0.5
MAX_SIGNAL_AGE_SECONDS=300
FILTER_SESSIONS=true
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
